{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "plugins": [
    "cargo-workspace"
  ],
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Miscellaneous",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "python",
      "component": "instro",
      "exclude-paths": [
        "crates"
      ]
    },
    "packages/instro-daq-labjack": {
      "release-type": "python",
      "component": "instro-daq-labjack"
    },
    "packages/instro-daq-mcc": {
      "release-type": "python",
      "component": "instro-daq-mcc"
    },
    "packages/instro-daq-ni": {
      "release-type": "python",
      "component": "instro-daq-ni"
    },
    "packages/instro-i2c-aardvark": {
      "release-type": "python",
      "component": "instro-i2c-aardvark"
    },
    "packages/instro-unstable": {
      "release-type": "python",
      "component": "instro-unstable"
    },
    "packages/instro-ethernetip": {
      "release-type": "rust",
      "component": "instro-ethernetip",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "project.version"
        }
      ]
    },
    "packages/instro-contrib": {
      "release-type": "python",
      "component": "instro-contrib"
    },
    "crates/instro-ethernetip": {
      "release-type": "rust",
      "component": "instro-ethernetip-rs",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true
    },
    "crates/instro-opcua": {
      "release-type": "rust",
      "component": "instro-opcua-rs",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true
    }
  }
}
