{
    "version": 1,
    "instrument": "InstroAWG",
    "device": {
        "name": "bench_awg",
        "description": "Bench waveform generator",
        "manufacturer": "Rigol",
        "model": "DG1022Z"
    },
    "driver": {
        "connection_type": "visa",
        "name": "RigolDG1022Z",
        "num_channels": 2,
        "visa": {
            "visa_resource": "USB0::0x1AB1::0x0642::DG1ZA000000000::INSTR"
        }
    },
    "channels": {
        "1": {
            "waveform": {
                "shape": "sine",
                "frequency_hz": 1000.0,
                "phase_deg": 0.0
            },
            "amplitude": {
                "value": 2.0,
                "unit": "VPP"
            },
            "offset": 0.0
        }
    },
    "timing": {
        "poll_interval": 1.0
    },
    "publishers": [
        {
            "type": "NominalCorePublisher",
            "dataset_rid": "<dataset_rid>"
        }
    ]
}
