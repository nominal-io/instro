{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "instro",
  "colors": {
    "primary": "#0B0B0B",
    "light": "#FFFFFF",
    "dark": "#0B0B0B"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Overview",
            "icon": "rocket",
            "root": "overview",
            "expanded": true,
            "pages": [
              "quickstart",
              "installation",
              "cli"
            ]
          },
          {
            "group": "Instruments",
            "icon": "microchip",
            "root": "instruments",
            "expanded": true,
            "pages": [
              "scope",
              "psu",
              "dmm",
              "daq",
              "awg",
              "eload",
              "flowcontroller"
            ]
          },
          {
            "group": "Library",
            "icon": "book-open",
            "root": "library/concepts",
            "expanded": true,
            "pages": [
              "library/library",
              "library/publishers",
              "library/protocols/overview",
              "library/transports/overview",
              "library/config-files",
              "library/simulated-instruments",
              "library/custom-instruments",
              "library/contrib",
              "library/exceptions"
            ]
          }
        ]
      },
      {
        "tab": "Examples",
        "groups": [
          {
            "group": "Stable",
            "pages": [
              "examples",
              "examples/daq/index",
              "examples/dmm/index",
              "examples/psu/index",
              "examples/eload/index",
              "examples/awg/index",
              "examples/i2c/index",
              "examples/publishers/index",
              "examples/modbus/index",
              "examples/ethernetip/index",
              "examples/test_rack_example/index",
              "examples/custom/index",
              "examples/scope/index"
            ]
          },
          {
            "group": "Additional packages",
            "pages": [
              "examples/unstable/index",
              "examples/contrib/index"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "href": "https://nominal-io.github.io/instro/"
      },
      {
        "tab": "GitHub",
        "href": "https://github.com/nominal-io/instro"
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/instro-logo-solid-black.svg",
    "dark": "/logo/instro-logo-solid-white.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Forum",
        "href": "https://community.instro.nominal.io"
      },
      {
        "label": "Discord",
        "href": "https://discord.gg/nN4RzhQkr"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get a demo",
      "href": "https://nominal.io/request-demo"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nominal_io",
      "discord": "https://discord.gg/nN4RzhQkr",
      "github": "https://github.com/nominal-io/instro",
      "linkedin": "https://linkedin.com/company/nominal-io"
    }
  },
  "seo": {
    "indexing": "all"
  },
  "interaction": {
    "drilldown": true
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-LR7QM29GGQ"
    }
  }
}
